# Copy to .env and fill in. .env is gitignored.

# MQTT broker Home Assistant uses (e.g. the Mosquitto add-on). Use an IP, not a .local name:
# containers can't resolve mDNS.
MQTT_BROKER=mqtt://192.168.1.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional
# MQTT_CLIENT_ID=orvibo2mqtt
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_STATE_PREFIX=orvibo2mqtt
# HA_STATUS_TOPIC=homeassistant/status
# ORVIBO_KEY=khggd54865SNJHGF
# ORVIBO_IDLE_TIMEOUT_MS=300000
# LOG_PACKETS=true
